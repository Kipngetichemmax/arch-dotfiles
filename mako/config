# -----------------------------
# Mako Notification Configuration
# -----------------------------

font=JetBrainsMono Nerd Font 10

background-color=#1e1e2eff
text-color=#cdd6f4ff
border-color=#89b4faff

border-size=2
border-radius=10

width=360
height=120

padding=14
margin=12
outer-margin=0

icons=1
icon-location=left
max-icon-size=40
icon-path=/usr/share/icons/Papirus-Dark

layer=top
anchor=top-right

default-timeout=4000
ignore-timeout=0

max-history=10
history=1
group-by=summary

sort=-time
max-visible=5

actions=1
text-alignment=left

on-button-left=invoke-default-action
on-button-middle=none
on-button-right=dismiss

on-touch=dismiss
on-notify=none

progress-color=over #313244

[urgency=high]
background-color=#1e1e2eff
border-color=#f38ba8ff
default-timeout=0
