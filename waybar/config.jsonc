
// ~/.config/waybar/config.jsonc
// Waybar config for Hyprland — Top bar
// Modules: workspaces | clock | battery, network, audio

{
    "layer": "top",
    "position": "top",
    "height": 28,
    "start_hidden": true,
    "spacing": 4,
    "margin-top": 3,
    "margin-left": 2,
    "margin-right": 2,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "bluetooth",
        "network",
        "battery"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by-number": true,
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },

    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 60
    },


    "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "󰝟 ",
    "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": [
            "",
            "",
            ""
        ]
    },
    "scroll-step": 5,
    "on-click": "wifi-manager --toggle", 
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} — {volume}%"
    },

    "network": {
        "format-wifi": " ",
        "format-ethernet": "󰈀 ",
        "format-disconnected": "󰖪 ",
        "format-linked": "󰈀 ",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}\n {bandwidthUpBytes}  {bandwidthDownBytes}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "interval": 5,
        "on-click": "wifi-manager --toggle"
    },

    "battery": {
    "format": "{icon} {capacity}",
    "format-plugged": " {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": [
        "",
        "",
        "",
        "",
        ""
    ]
    
    },

    "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": "",  
    "tooltip-format": "Bluetooth",
    "tooltip-format-connected": "{device_alias}",
    "on-click": "wifi-manager --toggle"    
    },

    "tray": {
        "spacing": 8,
        "icon-size": 16
    }
}
